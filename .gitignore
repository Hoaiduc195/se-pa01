# ==============================================================================
# .gitignore - Dự án Nhập môn Công nghệ Phần mềm (CSC13002)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hệ điều hành & File hệ thống (Operating System Files)  
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.fuse_hidden*
.Trash-*

# ------------------------------------------------------------------------------
# 2. Trình soạn thảo & Môi trường phát triển (IDEs & Editors)
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.ionide/

# JetBrains (IntelliJ, WebStorm, PyCharm, v.v.)
.idea/
*.iml
*.iws
*.ipr
cmake-build-*/

# Visual Studio
.vs/
[Bb]in/
[Oo]bj/

# Vim / Emacs / Sublime Text
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 3. Tài liệu văn phòng & Soạn thảo Slide (LaTeX & Office Temp Files)
# ------------------------------------------------------------------------------
# File tạm Microsoft Office (Word, Excel, PowerPoint lock files khi đang mở)
~$*.doc*
~$*.xls*
~$*.ppt*

# LaTeX Auxiliary / Intermediate Build Files (Biên dịch Beamer / Slide / Báo cáo)
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.run.xml
*.bcf
_minted-*
*.lot
*.lof
*.idx
*.ilg
*.ind

# ------------------------------------------------------------------------------
# 4. Môi trường & Bí mật cấu hình (Environment & Secrets)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example
!*.env.template

# Khóa bí mật & chứng thực
*.pem
*.key
*.cert
*.pfx
credentials.json
service-account*.json

# ------------------------------------------------------------------------------
# 5. Node.js & Javascript / Typescript / Web Stack
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
jspm_packages/
.pnp
.pnp.js

# Build output & Distribution
dist/
build/
out/
.next/
.nuxt/
.vuepress/dist
.serverless/
.docusaurus/

# Logs & Debugging
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache & Diagnostics
.npm
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.turbo/
.cache/
.parcel-cache/

# Coverage & Tests
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/

# ------------------------------------------------------------------------------
# 6. Python (FastAPI, Flask, Django, AI/ML Scripts)
# ------------------------------------------------------------------------------
# Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 7. Cơ sở dữ liệu cục bộ & Tệp tạm tải lên (Local Databases & Uploads)
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.local.db

# User uploads & Temporary files
uploads/
temp/
tmp/
